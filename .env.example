APP_NAME="On Point Call"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=onpoint_call
DB_USERNAME=onpoint
DB_PASSWORD=secret
# Required to run migrate:fresh / db:wipe against this database.
ALLOW_DESTRUCTIVE_DB=false

# Local Docker: use file session/cache. Do not run `php artisan optimize`
# locally — cached config/routes can break Filament and make `php artisan test`
# wipe Postgres. Use `php artisan optimize:clear` instead.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail: `log` writes to storage/logs (nothing is delivered).
# Resend: MAIL_MAILER=resend + RESEND_API_KEY.
# After send.onpointmrg.com is verified:
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@send.onpointmrg.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Soft Score API (secrets — never commit real values)
SOFT_SCORE_BASE_URL=https://prod.onpointapi.com
SOFT_SCORE_CLIENT_ID=
SOFT_SCORE_CLIENT_SECRET=
SOFT_SCORE_FRESHNESS_DAYS=15

# FCC Reassigned Numbers Database (secrets — never commit real values)
RND_BASE_URL=https://api.reassigned.us
RND_REFRESH_TOKEN=
RND_COMPANY_ID=

# Salesforce External Client App — Customer Qualification Apex REST
# Local/dev uses STAGE (prod is not provisioned yet). Keys live in
# Docs/API/QualificationService/qualification-api.md — do not commit real values here.
SALESFORCE_INSTANCE_URL=https://onpointmrg--staging.sandbox.my.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
QUALIFICATION_FRESHNESS_DAYS=15

# DNC.com / DNCScrub (secrets — never commit real values)
DNC_BASE_URL=https://www.dncscrub.com
DNC_LOGIN_ID=
DNC_PROJECT_ID=ONPNT

# Backblaze B2 backups (secrets — never commit real values)
BACKUP_DISK=b2
BACKUP_RETENTION_DAYS=30
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=us-west-004
