{
    # Set APP_URL domain in production; Caddy will obtain TLS automatically.
    # For local dev, use :80 below or set {$APP_DOMAIN} in .env.
    email {$CADDY_EMAIL:admin@example.com}
}

{$APP_DOMAIN:localhost} {
    root * /var/www/html/public
    encode gzip
    php_fastcgi app:9000
    file_server
}

# Fallback when APP_DOMAIN is not set (local Docker)
:80 {
    root * /var/www/html/public
    encode gzip
    php_fastcgi app:9000
    file_server
}
